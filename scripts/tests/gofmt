#!/bin/bash

# Verifies all Go source is gofmt-clean. Fails closed when the go toolchain is
# missing.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$SCRIPT_DIR/../.."

if ! command -v gofmt >/dev/null 2>&1; then
	echo "gofmt: go toolchain required (install go 1.24 or newer) — failing closed" >&2
	exit 1
fi

echo "==> gofmt -l"
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
	echo "gofmt: the following files are not formatted:" >&2
	echo "$unformatted" >&2
	exit 1
fi
echo "    ok: all Go source is gofmt-clean"
