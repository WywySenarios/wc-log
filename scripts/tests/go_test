#!/bin/bash

# Verifies the module compiles and passes its tests. Fails closed when the go
# toolchain is missing.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
cd "$SCRIPT_DIR/../.."

if ! command -v go >/dev/null 2>&1; then
	echo "go_test: go toolchain required (install go 1.24 or newer) — failing closed" >&2
	exit 1
fi

echo "==> go vet ./..."
go vet ./...
echo "    ok: go vet ./..."

echo "==> go test -race ./..."
go test -race ./...
echo "    ok: go test -race ./..."
