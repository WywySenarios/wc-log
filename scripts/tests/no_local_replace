#!/bin/bash

# Exercises scripts/check-no-local-replace against clean and offending go.mod
# files, so the consumer build-hygiene gate cannot silently regress.

set -euo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
CHECK="$REPO_ROOT/scripts/check-no-local-replace"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Clean: an ordinary module requirement.
cat >"$work/clean.mod" <<'EOF'
module example.com/consumer

go 1.24

require github.com/WywySenarios/wc-log v1.2.3
EOF

# Offending: a local-path replacement of wc-log.
cat >"$work/local.mod" <<'EOF'
module example.com/consumer

go 1.24

require github.com/WywySenarios/wc-log v1.2.3

replace github.com/WywySenarios/wc-log => ../wc-log
EOF

# Allowed: a module-path replacement (not a local path).
cat >"$work/module.mod" <<'EOF'
module example.com/consumer

go 1.24

require github.com/WywySenarios/wc-log v1.2.3

replace github.com/WywySenarios/wc-log => github.com/WywySenarios/wc-log v1.2.3
EOF

echo "==> check-no-local-replace accepts clean go.mod"
"$CHECK" "$work/clean.mod"

echo "==> check-no-local-replace accepts module-path replace"
"$CHECK" "$work/module.mod"

echo "==> check-no-local-replace rejects local-path replace"
if "$CHECK" "$work/local.mod" >"$work/out" 2>&1; then
	echo "no_local_replace: local-path replace was NOT rejected" >&2
	cat "$work/out" >&2
	exit 1
fi

echo "    ok: local-path replace rejected"
